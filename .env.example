# Copy this file to .env in the project root.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/history_ai?charset=utf8mb4

# Each external service uses an OpenAI-compatible HTTP API.
# Set PROVIDER=openai_compatible only after filling the key/model/base URL.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.example.com/v1
AI_TIMEOUT=60

ASR_PROVIDER=disabled
ASR_API_KEY=
ASR_MODEL=
ASR_BASE_URL=https://api.example.com/v1
ASR_TIMEOUT=60

TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_MODEL=
TTS_BASE_URL=https://api.example.com/v1
TTS_TIMEOUT=60
TTS_VOICE=alloy
TTS_FORMAT=mp3

# Optional frontend setting. Put it in frontend/.env when the backend is not local.
# VITE_API_BASE_URL=http://localhost:8000/api
