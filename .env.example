# Copy this file to .env in the project root.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/history_ai?charset=utf8mb4

# Knowledge source: demo keeps MySQL-first/JSON-fallback behavior; textbook
# reads only data/textbook_history_knowledge.json and never falls back to demo data.
KNOWLEDGE_MODE=demo

# Each external service uses credentials stored only in the local .env file.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.example.com/v1
AI_TIMEOUT=60

# ASR_PROVIDER supports: disabled, openai_compatible, aliyun_bailian.
ASR_PROVIDER=disabled
ASR_API_KEY=
ASR_MODEL=
ASR_BASE_URL=https://api.example.com/v1
ASR_TIMEOUT=60

# Aliyun Bailian Beijing example (replace <workspace-id> and keep the key local):
# ASR_PROVIDER=aliyun_bailian
# ASR_MODEL=qwen-audio-3.1-asr-flash
# ASR_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# TTS_PROVIDER supports: disabled, openai_compatible, aliyun_bailian.
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_MODEL=
TTS_BASE_URL=https://api.example.com/v1
TTS_TIMEOUT=60
TTS_VOICE=alloy
TTS_FORMAT=mp3

# Aliyun Bailian Beijing example (replace <workspace-id> and keep the key local):
# TTS_PROVIDER=aliyun_bailian
# TTS_MODEL=qwen-audio-3.1-tts-flash
# TTS_BASE_URL=wss://<workspace-id>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# TTS_VOICE=longanwen_v3.1
# TTS_FORMAT=mp3

# Optional frontend setting. Put it in frontend/.env when the backend is not local.
# VITE_API_BASE_URL=http://localhost:8000/api
