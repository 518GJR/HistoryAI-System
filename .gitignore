# Local PDF render/extraction previews.
tmp/pdfs/

# Local runtime, acceptance, and evaluation scratch data.
tmp/
*.db
*.sqlite
*.sqlite3
*.log

# Local embedding model cache and generated vector indexes.
.cache/
data/vector_index/
